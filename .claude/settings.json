{
  "$comment": [
    "Least-privilege agent permissions per alpha-spec.md 14.1.",
    "Changes to this file are a SECURITY BOUNDARY and require Security/Release owner approval (1.4).",
    "Deny rules are the safety net, not the only control: sandboxing and protected branches carry",
    "the real weight. Failure to establish the required sandbox is a hard failure for unattended",
    "sessions."
  ],
  "permissions": {
    "deny": [
      "Read(./.env.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.mozilla/**)",
      "Read(~/.config/google-chrome/**)",
      "Read(~/.cargo/credentials.toml)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",

      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(rm -rf /*)",
      "Bash(chmod -R 777:*)",
      "Bash(curl:* | sh)",
      "Bash(curl:* | bash)",
      "Bash(wget:* | sh)",

      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard origin/main)",
      "Bash(git commit --amend:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",

      "Bash(cargo publish:*)",
      "Bash(cargo login:*)",
      "Bash(npm publish:*)",
      "Bash(signtool:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(cargo add:*)",
      "Bash(cargo remove:*)",
      "Bash(cargo update:*)",
      "Bash(sqlx migrate revert:*)",
      "Bash(sqlx database drop:*)",
      "Write(./Cargo.toml)",
      "Write(./rust-toolchain.toml)",
      "Write(./justfile)",
      "Write(./scripts/verify.sh)",
      "Write(./scripts/verify.ps1)",
      "Write(./.claude/settings.json)",
      "Edit(./migrations/**)"
    ],
    "allow": [
      "Bash(just bootstrap)",
      "Bash(just verify)",
      "Bash(just check-fmt)",
      "Bash(just check-lint)",
      "Bash(just check-sqlx)",
      "Bash(just test-rust)",
      "Bash(just test-ffi)",
      "Bash(just audit)",
      "Bash(just check-typos)",
      "Bash(just evidence:*)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo nextest run:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo deny check:*)",
      "Bash(cargo audit:*)",
      "Bash(cargo sqlx prepare:*)",
      "Bash(sqlx migrate run:*)",
      "Bash(sqlx migrate info:*)",
      "Bash(sqlx database create:*)",
      "Bash(typos:*)",
      "Bash(./scripts/check-*.sh:*)",
      "Bash(./scripts/verify.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)"
    ]
  }
}
