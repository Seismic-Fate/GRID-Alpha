# Local development environment for the SQLx toolchain (ADR-002).
# Contains no credentials: SQLite is a file, and this path lives under gitignored target/.
# Developer-specific overrides belong in .env.local, which is gitignored.

DATABASE_URL=sqlite:target/grid-dev.db

# Offline by default so a FRESH CLONE COMPILES with no database, using the committed .sqlx
# cache — the property final-build-spec.md 8.2 and ADR-002 exist to provide.
#
# Without this line the query! macro sees DATABASE_URL, tries a live connection, finds no
# database and fails with E0282 — the committed cache is never consulted. Adversarial review
# of PR #1 caught exactly that: `cargo check -p grid-persistence` exited 101 on a fresh clone.
#
# `cargo sqlx prepare` overrides this internally for its own subprocess, so regenerating the
# cache and `check-sqlx` both still work. Verified: check, database create, migrate run,
# prepare --check --workspace and nextest all exit 0 with this file as committed.
SQLX_OFFLINE=true

# Why this file is COMMITTED rather than shipped as .env.example (review finding "minor 4"):
# SQLX_OFFLINE=true is load-bearing, not convenience. A fresh clone must compile with no
# database, and dotenv only fills variables the environment has not already set -- so an
# example file the developer must copy would leave every fresh clone broken until they did.
#
# The trade-off the reviewer names is real: the next person to add a variable will add it to a
# tracked file. Nothing credential-shaped belongs here. Developer-specific values go in
# .env.local, which is gitignored, and scripts/check-secrets.sh scans this file like any other.
