CLAUDE.local.md
.env.local

# Flutter / Dart
/app/build/
/app/.dart_tool/
/app/.flutter-plugins
/app/.flutter-plugins-dependencies
/app/windows/flutter/ephemeral/
/app/linux/flutter/ephemeral/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

