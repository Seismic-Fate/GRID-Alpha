# Flutter/Dart toolchain pin (alpha-spec.md 8.7, 8.11).
#
# Consumed by CI and by developers; app/pubspec.yaml declares the SDK constraint, this file
# fixes the exact toolchain so generated bindings are reproducible.
#
# flutter_rust_bridge must be the SAME version on both sides:
#   Rust  Cargo.toml [workspace.dependencies]  =2.5.0   (exact)
#   Dart  app/pubspec.yaml                      2.5.0   (exact)
#
# app/pubspec.lock is NOT yet committed: Flutter is not installed in the current environment,
# so it cannot be generated honestly here. Committing a hand-written lockfile would be worse
# than its absence. Tracked as a P1-10 precondition. Review finding M6.

flutter=3.24.0
dart=3.5.0
flutter_rust_bridge=2.5.0
